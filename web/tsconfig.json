{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true
  },
  // @kelpcore/web ships TypeScript source and plain .mjs modules (the
  // in-browser SSH layer). Listing it type-checks it with this project and
  // loads those .mjs files, which TypeScript otherwise skips in node_modules.
  "include": ["src", "node_modules/@kelpcore/web/web/src"]
}
