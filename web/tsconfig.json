{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true
  },
  // @kelpcore/web (../web-core, linked as an npm workspace) is TypeScript
  // source and plain .mjs modules (the in-browser SSH layer). Listing it
  // type-checks it with this project and loads those .mjs files.
  "include": ["src", "../web-core/src"]
}
